import { useState } from 'react';
import { useStore } from '@/store/useStore';
import { Plus, X, Trash2 } from 'lucide-react';

const CATEGORIES = ['כל הקטגוריות', 'סלון', 'מטבח', 'שינה', 'חדרי רחצה', 'חוץ', 'פרטים'];

const PRESET_IMAGES = [
  { url: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=400&q=80', tag: 'סלון' },
  { url: 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=400&q=80', tag: 'מטבח' },
  { url: 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?w=400&q=80', tag: 'שינה' },
  { url: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=400&q=80', tag: 'חדרי רחצה' },
  { url: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=400&q=80', tag: 'סלון' },
  { url: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=400&q=80', tag: 'חוץ' },
  { url: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&q=80', tag: 'פרטים' },
  { url: 'https://images.unsplash.com/photo-1567767292278-a4f21aa2d36e?w=400&q=80', tag: 'שינה' },
  { url: 'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=400&q=80', tag: 'מטבח' },
  { url: 'https://images.unsplash.com/photo-1505873242700-f289a29e1e0f?w=400&q=80', tag: 'פרטים' },
  { url: 'https://images.unsplash.com/photo-1618219944342-824e40a13285?w=400&q=80', tag: 'סלון' },
  { url: 'https://images.unsplash.com/photo-1540518614846-7eded433c457?w=400&q=80', tag: 'שינה' },
];

export default function MoodBoard() {
  const { projects, activeProjectId, addMoodBoardItem, removeMoodBoardItem } = useStore();
  const project = projects.find(p => p.id === activeProjectId);
  const [filter, setFilter] = useState('כל הקטגוריות');
  const [note, setNote] = useState('');
  const [customUrl, setCustomUrl] = useState('');
  const [addPanel, setAddPanel] = useState(false);

  if (!project) return (
    <div className="flex items-center justify-center h-64 text-ink-muted text-sm">בחר פרויקט פעיל מהסרגל הצדדי</div>
  );

  const filtered = filter === 'כל הקטגוריות'
    ? project.moodBoard
    : project.moodBoard.filter(m => m.tag === filter);

  const addImage = (url: string, tag: string) => {
    addMoodBoardItem(project.id, { url, note, tag, x: 0, y: 0, w: 1, h: 1 });
    setNote('');
    setAddPanel(false);
  };

  return (
    <div className="max-w-7xl space-y-5">
      <div className="flex items-center justify-between">
        <div>
          <h2 className="font-semibold text-lg">לוח השראה — {project.name}</h2>
          <p className="text-xs text-ink-muted">{project.moodBoard.length} תמונות</p>
        </div>
        <button onClick={() => setAddPanel(true)} className="btn-accent">
          <Plus size={15} /> הוסף תמונה
        </button>
      </div>

      {/* Filter */}
      <div className="flex gap-2 flex-wrap">
        {CATEGORIES.map(c => (
          <button key={c} onClick={() => setFilter(c)}
            className={`px-3 py-1.5 rounded-full text-xs font-medium transition-colors ${filter === c ? 'bg-accent text-white' : 'bg-surface border border-border text-ink-muted hover:border-accent hover:text-accent'}`}>
            {c}
          </button>
        ))}
      </div>

      {/* Board */}
      {filtered.length === 0 ? (
        <div className="flex flex-col items-center justify-center h-64 gap-3 border-2 border-dashed border-border rounded-xl text-ink-muted">
          <p className="text-sm">לוח ריק — הוסף תמונות ראשונות</p>
          <button onClick={() => setAddPanel(true)} className="btn-accent text-xs py-1.5">הוסף עכשיו</button>
        </div>
      ) : (
        <div className="columns-3 gap-4 space-y-4">
          {filtered.map(item => (
            <div key={item.id} className="break-inside-avoid group relative rounded-lg overflow-hidden">
              <img src={item.url} alt={item.note ?? ''} className="w-full object-cover" loading="lazy" />
              <div className="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-all flex items-end justify-between p-3 opacity-0 group-hover:opacity-100">
                {item.note && <p className="text-white text-xs bg-black/50 rounded px-2 py-1">{item.note}</p>}
                {item.tag && <span className="text-xs bg-accent text-white px-2 py-0.5 rounded-full">{item.tag}</span>}
              </div>
              <button
                onClick={() => removeMoodBoardItem(project.id, item.id)}
                className="absolute top-2 right-2 w-7 h-7 bg-black/60 rounded flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-500"
              >
                <Trash2 size={13} className="text-white" />
              </button>
            </div>
          ))}
        </div>
      )}

      {/* Add panel */}
      {addPanel && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
          <div className="bg-surface rounded-xl w-full max-w-3xl max-h-[85vh] overflow-y-auto">
            <div className="flex items-center justify-between p-5 border-b border-border">
              <h3 className="font-semibold">הוסף תמונה ללוח</h3>
              <button onClick={() => setAddPanel(false)}><X size={18} className="text-ink-muted" /></button>
            </div>
            <div className="p-5 space-y-4">
              <div>
                <label className="label">הערה לתמונה (אופציונלי)</label>
                <input className="input" placeholder="למשל: פלטת צבעים לסלון..." value={note} onChange={e => setNote(e.target.value)} />
              </div>

              {/* Custom URL */}
              <div className="flex gap-2">
                <input className="input flex-1" placeholder="URL של תמונה..." value={customUrl} onChange={e => setCustomUrl(e.target.value)} />
                <button disabled={!customUrl} onClick={() => addImage(customUrl, filter === 'כל הקטגוריות' ? 'כללי' : filter)} className="btn-accent px-4 disabled:opacity-40">הוסף</button>
              </div>

              <div className="text-xs text-ink-muted text-center">— או בחר מהגלריה —</div>

              {/* Preset images */}
              <div className="grid grid-cols-4 gap-2">
                {PRESET_IMAGES
                  .filter(img => filter === 'כל הקטגוריות' || img.tag === filter)
                  .map(img => (
                    <button key={img.url} onClick={() => addImage(img.url, img.tag)}
                      className="group relative rounded overflow-hidden aspect-square border-2 border-transparent hover:border-accent transition-all">
                      <img src={img.url} alt="" className="w-full h-full object-cover" />
                      <div className="absolute bottom-1 right-1">
                        <span className="text-xs bg-black/60 text-white px-1.5 py-0.5 rounded">{img.tag}</span>
                      </div>
                    </button>
                  ))}
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
