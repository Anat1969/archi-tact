import { useState } from 'react';
import { useStore } from '@/store/useStore';
import { fmt, pct } from '@/lib/utils';
import { Plus, X, Trash2 } from 'lucide-react';
import { useNavigate } from 'react-router-dom';
import type { ProjectStatus, ProjectPhase } from '@/types';

const STATUS: ProjectStatus[] = ['תכנון', 'בביצוע', 'בהמתנה', 'הושלם'];

const STATUS_STYLE: Record<string, string> = {
  'בביצוע': 'bg-blue-50 text-blue-700 border-blue-200',
  'תכנון': 'bg-amber-50 text-amber-700 border-amber-200',
  'בהמתנה': 'bg-gray-50 text-gray-600 border-gray-200',
  'הושלם': 'bg-green-50 text-green-700 border-green-200',
};

export default function Projects() {
  const { projects, addProject, deleteProject, setActiveProject } = useStore();
  const navigate = useNavigate();
  const [showForm, setShowForm] = useState(false);
  const [form, setForm] = useState({ name: '', clientName: '', clientEmail: '', clientPhone: '', address: '', area: '', budget: '', startDate: '', endDate: '', status: 'תכנון' as ProjectStatus, phase: 'תיאום' as ProjectPhase, description: '' });

  const submit = (e: React.FormEvent) => {
    e.preventDefault();
    addProject({
      name: form.name, address: form.address, area: Number(form.area),
      budget: Number(form.budget), spent: 0, status: form.status, phase: form.phase,
      startDate: form.startDate, endDate: form.endDate, description: form.description,
      coverImage: `https://images.unsplash.com/photo-1600585154526-990dced4db0d?w=600&q=80`,
      tags: [], client: { id: Math.random().toString(36).slice(2), name: form.clientName, email: form.clientEmail, phone: form.clientPhone },
    });
    setShowForm(false);
    setForm({ name: '', clientName: '', clientEmail: '', clientPhone: '', address: '', area: '', budget: '', startDate: '', endDate: '', status: 'תכנון', phase: 'תיאום', description: '' });
  };

  const open = (id: string) => { setActiveProject(id); navigate('/'); };

  return (
    <div className="max-w-7xl space-y-5">
      <div className="flex items-center justify-between">
        <div>
          <h2 className="font-semibold text-lg">כל הפרויקטים</h2>
          <p className="text-xs text-ink-muted">{projects.length} פרויקטים</p>
        </div>
        <button onClick={() => setShowForm(true)} className="btn-accent">
          <Plus size={15} /> פרויקט חדש
        </button>
      </div>

      {/* Grid */}
      <div className="grid grid-cols-3 gap-4">
        {projects.map(p => (
          <div key={p.id} className="card overflow-hidden group cursor-pointer hover:shadow-md transition-shadow" onClick={() => open(p.id)}>
            <div className="relative -mx-5 -mt-5 mb-4">
              <img src={p.coverImage} alt={p.name} className="w-full h-36 object-cover" />
              <div className="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors" />
              <button
                onClick={(e) => { e.stopPropagation(); if (confirm('למחוק את הפרויקט?')) deleteProject(p.id); }}
                className="absolute top-2 left-2 w-7 h-7 bg-black/50 rounded flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-500"
              >
                <Trash2 size={13} className="text-white" />
              </button>
              <span className={`absolute bottom-2 right-2 badge border ${STATUS_STYLE[p.status]}`}>{p.status}</span>
            </div>
            <div className="font-semibold text-sm mb-0.5 truncate">{p.name}</div>
            <div className="text-xs text-ink-muted mb-3">{p.client.name} · {p.address}</div>
            <div className="flex justify-between text-xs text-ink-muted mb-1.5">
              <span>התקדמות</span><span>{p.progress}%</span>
            </div>
            <div className="h-1.5 bg-border rounded-full overflow-hidden mb-3">
              <div className="h-full bg-accent rounded-full" style={{ width: `${p.progress}%` }} />
            </div>
            <div className="flex justify-between text-xs">
              <span className="text-ink-muted">תקציב: <span className="text-ink font-medium">{fmt(p.budget)}</span></span>
              <span className="text-ink-muted">נוצל: <span className={pct(p.spent, p.budget) > 90 ? 'text-red-500 font-medium' : 'text-ink'}>{pct(p.spent, p.budget)}%</span></span>
            </div>
          </div>
        ))}
      </div>

      {/* Modal */}
      {showForm && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
          <div className="bg-surface rounded-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between p-5 border-b border-border">
              <h3 className="font-semibold">פרויקט חדש</h3>
              <button onClick={() => setShowForm(false)} className="text-ink-muted hover:text-ink"><X size={18} /></button>
            </div>
            <form onSubmit={submit} className="p-5 space-y-4">
              <div className="grid grid-cols-2 gap-4">
                <div className="col-span-2">
                  <label className="label">שם הפרויקט</label>
                  <input required className="input" value={form.name} onChange={e => setForm(f => ({ ...f, name: e.target.value }))} placeholder="וילה פרטית — שיכון דן" />
                </div>
                <div>
                  <label className="label">שם הלקוח</label>
                  <input required className="input" value={form.clientName} onChange={e => setForm(f => ({ ...f, clientName: e.target.value }))} placeholder="משפחת כהן" />
                </div>
                <div>
                  <label className="label">מייל לקוח</label>
                  <input className="input" type="email" value={form.clientEmail} onChange={e => setForm(f => ({ ...f, clientEmail: e.target.value }))} />
                </div>
                <div>
                  <label className="label">כתובת</label>
                  <input required className="input" value={form.address} onChange={e => setForm(f => ({ ...f, address: e.target.value }))} />
                </div>
                <div>
                  <label className="label">שטח (מ"ר)</label>
                  <input required type="number" className="input" value={form.area} onChange={e => setForm(f => ({ ...f, area: e.target.value }))} />
                </div>
                <div>
                  <label className="label">תקציב (₪)</label>
                  <input required type="number" className="input" value={form.budget} onChange={e => setForm(f => ({ ...f, budget: e.target.value }))} />
                </div>
                <div>
                  <label className="label">סטטוס</label>
                  <select className="input" value={form.status} onChange={e => setForm(f => ({ ...f, status: e.target.value as ProjectStatus }))}>
                    {STATUS.map(s => <option key={s}>{s}</option>)}
                  </select>
                </div>
                <div>
                  <label className="label">תאריך התחלה</label>
                  <input type="date" className="input" value={form.startDate} onChange={e => setForm(f => ({ ...f, startDate: e.target.value }))} />
                </div>
                <div>
                  <label className="label">תאריך סיום</label>
                  <input type="date" className="input" value={form.endDate} onChange={e => setForm(f => ({ ...f, endDate: e.target.value }))} />
                </div>
                <div className="col-span-2">
                  <label className="label">תיאור</label>
                  <textarea rows={3} className="input resize-none" value={form.description} onChange={e => setForm(f => ({ ...f, description: e.target.value }))} />
                </div>
              </div>
              <div className="flex gap-3 pt-2">
                <button type="submit" className="btn-accent flex-1">צור פרויקט</button>
                <button type="button" onClick={() => setShowForm(false)} className="btn-outline flex-1">ביטול</button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
